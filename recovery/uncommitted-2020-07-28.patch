+
+    size_t  stringlength;
+    int     i;
+    size_t  j;
+    int     k;
+
+    int     redsorted[MAX_CLIENTS];
+    int     redsortedscores[MAX_CLIENTS];
+    int     bluesorted[MAX_CLIENTS];
+    int     bluesortedscores[MAX_CLIENTS];
+
+    int     score;
+
+    int     rune_strength;
+    int     rune_haste;
+    int     rune_regen;
+    int     rune_resist;
+    int     item_mega;
+    int     item_armor;
