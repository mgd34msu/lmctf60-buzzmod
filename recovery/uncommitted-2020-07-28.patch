+            stats_get(cl_ent, STATS_OFFENSE_CARRIER),
+            stats_get(cl_ent, STATS_DEFENSE_FLAG) + stats_get(cl_ent, STATS_DEFENSE_BASE),
+            stats_get(cl_ent, STATS_RETURNS)
