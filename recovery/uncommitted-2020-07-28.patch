+        cl = &game.clients[redsorted[i]];
+        cl_ent = g_edicts + 1 + redsorted[i];
+
+        x = -91;
+        y = 34 + 8 * i;
+
+        // send the layout        
+        Com_sprintf(string2, sizeof(string2),
+            "xv %i yv %i string2 \"%-15s %3i %2i %2i %2i\" ",
+
+            x, y,
