+            bluesortedscores[j] = score;
+            blue++;
+        }
+
+    }
+
+    string[0] = 0;
+    string2[0] = 0;
+    stringlength = 0;
+    y = 32 * 8;
+
+    // DRAW STATBOARD AND ADD TEAM STATS
+    {
+        Com_sprintf(string2, sizeof(string2),
+            "xv %i yv %i picn %s "
+            "xv %i yv %i picn %s ",
+
+            -102, -35, "pb",
+            -102, -27, "pt"
+
+        );
